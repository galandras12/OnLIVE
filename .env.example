# =============================================================================
#  OnLIVE — környezeti változók (SABLON)
#  Másold `.env` néven a repó gyökerébe, és töltsd ki. A `.env` NEM kerül a repóba.
# =============================================================================

# --- Publikus, fix URL-ek (1. szegmens — Cloudflare Tunnel) -------------------
# Ezek soha nem változnak IP-váltáskor, rebootkor vagy router-cserekor.
ONLIVE_PUBLIC_ADMIN_URL=https://admin.galandras.com
ONLIVE_PUBLIC_LIVE_URL=https://live.galandras.com
ONLIVE_PUBLIC_INGEST_URL=https://ingest.galandras.com

# --- Helyi portok -------------------------------------------------------------
# A vezérlő szerver (Express + Socket.io) portja — ide mutat az admin és a live.
ONLIVE_SERVER_PORT=3000
# A MediaMTX WHIP/WebRTC portja — ide mutat az ingest subdomain.
ONLIVE_MEDIAMTX_WHIP_PORT=8889
# A MediaMTX HTTP API-ja (stream-állapot lekérdezéshez).
ONLIVE_MEDIAMTX_API_PORT=9997

# --- Stream azonosító ---------------------------------------------------------
# A teljes WHIP URL: ${ONLIVE_PUBLIC_INGEST_URL}/${ONLIVE_STREAM_PATH}/whip
ONLIVE_STREAM_PATH=onlive

# --- Media ingest (3. szegmens) ----------------------------------------------
# A MediaMTX publish-felhasználója; a telefon ezzel + a streamkulccsal
# hitelesít HTTP Basic fejlécen.
ONLIVE_INGEST_USER=publisher
# A MediaMTX runOnReady/runOnNotReady hookok közös titka. A vezérlő szerver
# ezt ellenőrzi az X-OnLIVE-Hook-Secret fejlécben.
ONLIVE_HOOK_SECRET=valtoztasd-meg
# Az ingest-figyelés paraméterei (docs/INGEST.md 3.2).
ONLIVE_INGEST_POLL_MS=1000
ONLIVE_INGEST_INTERRUPT_AFTER_MS=3000

# --- OBS / lejátszás (6. szegmens) --------------------------------------------
# A /live oldal védelme. Üresen hagyva NYILVÁNOS — így az OBS Browser
# Source-ba elég a puszta URL. Ha megadod, minden lejátszási kérés és a
# Socket.io kapcsolat is kéri (?token=...).
ONLIVE_LIVE_TOKEN=
# A MediaMTX HLS portja (tartalék lejátszási útvonal).
ONLIVE_MEDIAMTX_HLS_PORT=8888

# --- Állapotgép (4. szegmens) -------------------------------------------------
# A 2 perces küszöb. KIZÁRÓLAG az intro vs. reconnecting döntést befolyásolja.
ONLIVE_LIVE_THRESHOLD_MS=120000
# Meddig tartson az outro, mielőtt ended állapotba lépnénk.
ONLIVE_OUTRO_DURATION_MS=15000
# Minden indítás játssza-e az intro médiát, vagy csak a boot utáni első.
ONLIVE_INTRO_ON_EVERY_START=true
# Leálljon-e maga a szerver folyamat is az ended állapotban.
# Alapból NEM: különben az admin felület is elérhetetlenné válna, és a
# tunnel-watchdog hibának látná. Lásd docs/STATE-MACHINE.md 8.1.
ONLIVE_SHUTDOWN_ON_ENDED=false

# --- Titkok és hitelesítés (10. szegmens) -------------------------------------
# MINDET generáld:  cd server && npm run keygen
#
# Az Android app ezzel hitelesít az ingest felé. EZ AZ EGYETLEN védelme a WHIP
# végpontnak — aki kitalálja, idegen streamet publikálhat a nevedben. Ugyanezt
# az értéket a MediaMTX konfigurációjába is be kell írni.
ONLIVE_STREAM_KEY=valtoztasd-meg
#
# Az admin jelszó. AJÁNLOTT a hash-elt forma:
#   cd server && npm run hash-password -- "a jelszavad"
# Ha a hash meg van adva, a sima szöveges sor törölhető.
ONLIVE_ADMIN_PASSWORD=valtoztasd-meg
ONLIVE_ADMIN_PASSWORD_HASH=
#
# Engedélyezett-e a fejléces admin hitelesítés (X-OnLIVE-Admin-Password).
# Szkriptekhez/curl-höz kell; ha csak böngészőből vezérelsz, tedd false-ra.
ONLIVE_ALLOW_HEADER_AUTH=true
#
# Meddig éljen egy admin munkamenet az utolsó használat után (ms).
ONLIVE_SESSION_TTL_MS=43200000

# --- Watchdog (opcionális) ----------------------------------------------------
# Ha meg van adva, a tunnel watchdog ide POST-ol értesítést (Slack/Discord webhook).
ONLIVE_WATCHDOG_WEBHOOK=

# --- TURN a WebRTC médiaúthoz (lásd docs/NETWORKING.md 3. fejezet) ------------
# A WHIP jelzés átmegy a Cloudflare Tunnelen, a média NEM — ahhoz TURN kell.
ONLIVE_TURN_URL=
ONLIVE_TURN_USERNAME=
ONLIVE_TURN_CREDENTIAL=
