{
  "name": "onlive-server",
  "version": "0.1.0",
  "private": true,
  "description": "OnLIVE vezérlő szerver — állapotgép, ingest-figyelés, admin API, valós idejű állapot-szinkron",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=../.env tools/start.js",
    "dev": "node --env-file-if-exists=../.env --watch src/index.js",
    "test": "node --test test/*.test.js",
    "keygen": "node tools/keygen.js",
    "hash-password": "node tools/keygen.js hash",
    "start:server": "node --env-file-if-exists=../.env src/index.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "hls.js": "^1.7.0",
    "multer": "^2.2.0",
    "socket.io": "^4.8.1"
  }
}
